VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Seed script'lerinin YENI kullaniciya atayacagi baslangic sifresi.
# Uygulama bundle'ina GOMULMEZ; giris ekranda kullanici tarafindan yazilir.
# Var olan kullanicilarin sifresini sifirlamak icin: SEED_RESET_PASSWORD=1
VITE_DEFAULT_PASSWORD=change-me
# scripts/seed-users.mjs icin gerekli (sadece local seed; uygulama kullanmaz)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
