  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dev-port.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "vite build --config vite.analyze.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed:users": "node scripts/seed-users.mjs",
    "seed:config": "node scripts/seed-config.mjs",
    "seed:migration": "node scripts/seed-migration.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "new:santiye": "node scripts/new-santiye.mjs",
    "build:config": "node scripts/build-config.mjs && node scripts/validate-config.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
